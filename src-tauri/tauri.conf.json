{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BookReader",
  "version": "0.1.0",
  "identifier": "com.bookreader.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BookReader",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "简洁的 Windows EPUB 阅读器",
    "longDescription": "一款本地优先、支持同步目录的 Windows EPUB 阅读器。"
  }
}
